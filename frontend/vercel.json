{
  "redirects": [
    { "source": "/services/safety-walkthrough", "destination": "/safety-walkthrough", "permanent": true },
    { "source": "/services/safety-walkthrough-report", "destination": "/safety-walkthrough", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms", "destination": "/terms-of-service", "permanent": true },
    { "source": "/request-walkthrough", "destination": "/intake", "permanent": true },
    { "source": "/onboarding", "destination": "/intake", "permanent": true },
    { "source": "/onboarding/confirmed", "destination": "/intake", "permanent": true },
    { "source": "/case-studies/mocksville-plastics-osha-inspection", "destination": "/case-study/metals-fabrication-statesville", "permanent": true },
    { "source": "/services/osha-ready-control-system", "destination": "/services/safety-control-system-buildout", "permanent": true },
    { "source": "/services/osha-ready-control-system/request", "destination": "/services/safety-control-system-buildout/request", "permanent": true },
    { "source": "/documentation-gap-check", "destination": "/services/documentation-readiness-review", "permanent": true },
    { "source": "/services/document-development", "destination": "/services/documentation-readiness-review", "permanent": true },
    { "source": "/osha-compliance-gap-check", "destination": "/services/compliance-readiness-visit", "permanent": true },
    { "source": "/walkthrough", "destination": "/intake", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "giglinecompliance.com" }],
      "destination": "https://www.giglinecompliance.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sample-corrective-action-log", "destination": "/assets/GigLine_Sample_Corrective_Action_Log.pdf" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://giglinesite-production.up.railway.app https://*.up.railway.app https://*.preview.emergentagent.com https://formspree.io; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io; object-src 'none'; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico|woff2|woff)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/field-notes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/floor-findings/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
